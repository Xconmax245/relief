generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Application {
  id               String   @id @default(cuid())
  referenceNumber  String   @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  ssnEncrypted     String   // AES-256-GCM encrypted last 4 digits
  email            String
  phone            String
  address          String
  city             String
  state            String   // 2-letter code
  zipCode          String
  annualIncome     String   // enum: under-25k, 25k-50k, 50k-75k, 75k-100k, over-100k
  accountType      String   // checking or savings
  routingEncrypted String   // AES-256-GCM encrypted 9-digit routing number
  accountEncrypted String   // AES-256-GCM encrypted account number
  consent          Boolean
  status           String   @default("pending") // pending, approved, rejected
  adminNotes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditLogs        AuditLog[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin, superadmin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g., "VIEW_APPLICATION", "UPDATE_STATUS", "EXPORT_CSV", "EXPORT_APPLICATION_PDF"
  entity     String   // e.g., "Application", "AdminUser"
  entityId   String?
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  ipAddress  String?
  userAgent  String?
  changes    String?   // Store JSON string or metadata
  createdAt  DateTime @default(now())
}
